# Copy to .env and fill in.

# Only needed if the MCP server itself ever needs to call OpenAI directly
# (it normally doesn't - it just serves data). Leave empty otherwise.
OPENAI_API_KEY=

# REQUIRED in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without this set, a random key is generated per-process (dev convenience
# only) and previously-saved BYOK keys become unreadable after a restart.
BYOK_ENCRYPTION_KEY=

DEFAULT_CHAT_MODEL=gpt-4o
MAX_TOOL_LOOPS=5
HOST=0.0.0.0
PORT=8000
